#!name=Busuu解锁VIP
#!desc=博树 VIP 解锁模块
#!system=ios
[Script]
Busuu = type=http-response,pattern=^https?:\/\/.*\/users\/me,requires-body=1,max-size=0,script-path=https://github.com/vplkos/jovery/blob/main/scripts/busuu.js,binary-body-mode=0,script-update-interval=0
[MITM]
hostname = *.boshu.*, *.bosuu.com, *.busuu.com
