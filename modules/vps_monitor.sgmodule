#!name=VPS 极客监控面板
#!desc=由 Go 后端驱动的高性能轻量级 VPS 状态监控面板。支持自定义服务器地址、鉴权密钥及面板样式。
#!category=工具
#!arguments=url:"http://127.0.0.1:40728",key:"your_super_secret_key",name:"Server Info",icon:"party.popper",interval:15
#!arguments-desc=\n1️⃣ 后端地址\n\n请输入你的 Go 后端服务公网地址，例如：http://3.112.233.133:40728\n\n2️⃣ 鉴权密钥\n\n对应你在 Docker-compose 里配置的 API_KEY 暗号\n\n3️⃣ 面板标题\n\n显示在 Surge 面板左上角的服务器别名\n\n4️⃣ 面板图标\n\n支持 SF Symbols 图标，例如 party.popper 或 server.rack\n\n5️⃣ 刷新间隔\n\n面板自动刷新的时间（秒），建议保持 15 或 30

[Script]
# 👈 核心：完全照搬 Sub-Store 模版，利用三花括号把图形化参数传给脚本
VPS_Monitor_Script = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/vplkos/jovery/main/scripts/vps_panel.js,argument="url={{{url}}}&key={{{key}}}&name={{{name}}}&icon={{{icon}}}"

[Panel]
VPS_Monitor_Script = script-name=VPS_Monitor_Script,update-interval={{{interval}}}
