#!name=Busuu解锁VIP
#!desc=解锁 Busuu 会员功能，基于 users/me 接口修改。
#!system=ios

[Script]
Busuu_Unlock = type=http-response,pattern=^https:\/\/api\.busuu\.com\/.*,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/vplkos/jovery/main/scripts/busuuunlock.js

[MITM]
hostname = api.busuu.com
