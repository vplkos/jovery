#!name=VPS 监控
#!desc=监控两台服务器 (CPU/内存/磁盘/流量/在线时间)，地址与 Token 均可自定义
#!author=Brio
#!category=VPS 监控
#!arguments=TITLE:甲骨文服务器监控,NODE1_NAME:Osaka01,NODE1:152.70.85.214:9100,NODE2_NAME:Osaka02,NODE2:161.33.41.236:9100,TOKEN:监控 Token,ICON:server.rack,ICON_COLOR:#58A6FF
#!arguments-desc=[参数设置]\n\n⓵ TITLE: 面板标题。\n\n⓶ NODE1_NAME / NODE2_NAME: 节点显示名。\n\n⓷ NODE1 / NODE2: 节点地址，格式 IP:端口。\n\n⓸ TOKEN: 监控 Token，与 vps-agent 的 VPS_MONITOR_TOKEN 一致。\n\n⓹ ICON: 自定义面板图标，需为有效的 SF Symbol 名。\n\n⓺ ICON_COLOR: 自定义图标颜色，需为颜色的 HEX 编码。

[Panel]
{{{TITLE}}}=script-name={{{TITLE}}},update-interval=30

[Script]
{{{TITLE}}}=type=generic,timeout=10,script-path=https://raw.githubusercontent.com/vplkos/jovery/main/surge/vps-panel.js,script-update-interval=0,argument=title={{{TITLE}}}&icon={{{ICON}}}&color={{{ICON_COLOR}}}&node1_name={{{NODE1_NAME}}}&node1={{{NODE1}}}&node2_name={{{NODE2_NAME}}}&node2={{{NODE2}}}&token={{{TOKEN}}}
